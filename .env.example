# Free AI Image Generation API (https://github.com/saurav-z/free-image-generation-api)
FREE_IMAGE_API_URL=https://mute-flower-c21c.falconbot.workers.dev
FREE_IMAGE_API_KEY=your-secret-worker-api-key
FREE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Optional Direct Cloudflare Workers AI REST Credentials (if not using Worker URL)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Storyboard LLM (Microsoft Foundry / OpenAI-compatible)
FOUNDRY_TEXT_API_KEY=
FOUNDRY_TEXT_ENDPOINT=
FOUNDRY_TEXT_MODEL=gpt-6-luna

# Multi-Character Hindi Voiceover (Azure Speech SDK with automatic Edge Neural TTS fallback)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE=hi-IN-MadhurNeural
AZURE_TTS_FEMALE_VOICE=hi-IN-SwaraNeural
VOICE_SPEED_PERCENT=0

# Optional Foundry Image Generation Fallback
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=
FOUNDRY_IMAGE_MODEL=gpt-image-1-mini
MAX_AI_IMAGES_PER_VIDEO=90

# YouTube Data API v3 Upload (includes automatic AI altered/synthetic content tags)
YOUTUBE_TOKEN_JSON=
YOUTUBE_PRIVACY_STATUS=public
DRY_RUN=true

# Audio Mix
BG_MUSIC_VOLUME=0.16
MEDIA_CACHE_DIR=.cache/media
